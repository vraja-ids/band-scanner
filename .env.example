# Environment Variables - DO NOT COMMIT TO GIT
# Copy this file to .env.local and add your actual values

# ============================================================================
# GOOGLE APPS SCRIPT (Primary Backend for Prasadam Distribution)
# ============================================================================
# Deployed web app URL for Prasadam Distribution
# Deploy from: https://script.google.com - Use GoogleAppsScript.code.optimized.js
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# ============================================================================
# GOOGLE SHEETS API (for Bhoga Tracker)
# ============================================================================

# Google Sheets API Key for accessing Google Sheets data
# Get your API key from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Google Sheets ID for Rishikesh Kirtan Fest (and other events)
EXPO_PUBLIC_GOOGLE_SHEETS_ID=1OrrbYFPnTcup30nI3vh0mEDRzi9fztrEvhBwuE_cxBc

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Prasadam Distribution Spreadsheet ID (for additional features)
EXPO_PUBLIC_PRASADAM_SPREADSHEET_ID=your-spreadsheet-id-here

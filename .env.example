# Environment Variables - DO NOT COMMIT TO GIT
# Copy this file to .env.local and add your actual values

# ============================================================================
# SUPABASE CONFIGURATION (Primary Backend)
# ============================================================================
# Get these from your Supabase project: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Edge Function URL for syncing to Google Sheets (optional)
# Deploy the sync-to-sheets edge function and enter its URL here
EXPO_PUBLIC_SHEETS_SYNC_FUNCTION_URL=https://your-project.supabase.co/functions/v1/sync-to-sheets

# Prasadam Distribution Spreadsheet ID (for backup sync)
EXPO_PUBLIC_PRASADAM_SPREADSHEET_ID=1iiq9EeSDQ9eQzwkK4rQPbNXJGD_cnp-z0bnlWzDcW6g

# ============================================================================
# GOOGLE SHEETS CONFIGURATION (Backup / Fallback)
# ============================================================================

# Google Sheets API Key for accessing Google Sheets data
# Get your API key from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_SHEETS_API_KEY=your_api_key_here

# Google Sheets ID for Rishikesh Kirtan Fest (and other events)
EXPO_PUBLIC_GOOGLE_SHEETS_ID=1OrrbYFPnTcup30nI3vh0mEDRzi9fztrEvhBwuE_cxBc

# ============================================================================
# GOOGLE SHEETS SYNC (for Node.js sync script)
# ============================================================================
# Only needed if running the sync script separately

# Supabase Service Role Key (from Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Google Spreadsheet ID for Prasadam Distribution
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# Google Service Account (for syncing to Sheets)
# Download the JSON key file from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# ============================================================================
# GOOGLE APPS SCRIPT (Legacy Backend)
# ============================================================================
# Deployed web app URL for Prasadam Distribution
# This is used as fallback when Supabase is not available
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Force use of Google Sheets even when Supabase is configured
# Set to 'true' to disable Supabase
EXPO_PUBLIC_FORCE_SHEETS_BACKEND=false

// ============================================================================
// Dashboard Settings
// ============================================================================

export async function getDashboardSettings(
  eventId: string
): Promise<DashboardSetting[]> {
  const { data, error } = await supabase
    .from('dashboard_settings')
    .select('*')
    .eq('event_id', eventId);

  if (error) {
    console.error('[SupabaseService] getDashboardSettings error:', error);
    return [];
  }
  return data || [];
}

export async function saveDashboardSettings(
  settings: DashboardSettingInsert[]
): Promise<boolean> {
  // Delete existing settings for this event
  const eventId = settings[0]?.event_id;
  if (!eventId) return false;

  // Use a transaction-like operation
  const { error: deleteError } = await supabase
    .from('dashboard_settings')
    .delete()
    .eq('event_id', eventId);

  if (deleteError) {
    console.error('[SupabaseService] saveDashboardSettings delete error:', deleteError);
    return false;
  }

  // Insert new settings
  const { error: insertError } = await supabase
    .from('dashboard_settings')
    .insert(settings);

  if (insertError) {
    console.error('[SupabaseService] saveDashboardSettings insert error:', insertError);
    return false;
  }

  return true;
}

// ============================================================================
// Dashboard Summary
// ============================================================================

export async function getDashboardSummary(
  mealId: string
): Promise<DashboardSummaryData | null> {
  // Query menu items and inventory in parallel
  const [menuItems, inventory, transfersData, refillRequestsData] = await Promise.all([
    getMenuItems(mealId),
    getLocationInventory(mealId),
    supabase.from('transfers').select('*').eq('meal_id', mealId).eq('status', 'sent'),
    supabase.from('refill_requests').select('*').eq('meal_id', mealId).eq('status', 'pending'),
  ]);

  const pendingTransfersCount = transfersData.data?.length || 0;
  const pendingRequestsCount = refillRequestsData.data?.length || 0;

  return {
    menu: menuItems,
    inventory: inventory,
    pendingTransfersCount,
    pendingRequestsCount,
  };
}

// ============================================================================
// Real-time Subscriptions
// ============================================================================

type SubscriptionCallback<T> = (payload: RealtimePayload<T>) => void;

export function subscribeToTable<T>(
  table: RealtimeChannel,
  filter: { column: string; value: string } | null,
  callback: SubscriptionCallback<T>
): (() => void) {
  let query = supabase.channel(`${table}_changes`).on(
    'postgres_changes',
    {
      event: '*',
      schema: 'public',
      table: table,
      filter: filter ? `${table}.${filter.column}=eq.${filter.value}` : undefined,
    },
    (payload) => callback(payload as RealtimePayload<T>)
  );

  query.subscribe();

  // Return unsubscribe function
  return () => {
    supabase.removeChannel(query);
  };
}

export function subscribeToMealInventory(
  mealId: string,
  callback: (inventory: LocationInventory[]) => void
): (() => void) {
  const channel = supabase
    .channel(`meal_${mealId}_inventory`)
    .on(
      'postgres_changes',
      {
        event: '*',
        schema: 'public',
        table: 'location_inventory',
        filter: `location_inventory.meal_id=eq.${mealId}`,
      },
      async () => {
        // Refetch inventory on changes
        const inventory = await getLocationInventory(mealId);
        callback(inventory);
      }
    )
    .subscribe();

  return () => {
    supabase.removeChannel(channel);
  };
}

export function subscribeToPendingTransfers(
  toLocation: string,
  callback: (transfers: Transfer[]) => void
): (() => void) {
  const channel = supabase
    .channel(`transfers_${toLocation}`)
    .on(
      'postgres_changes',
      {
        event: '*',
        schema: 'public',
        table: 'transfers',
        filter: `transfers.to_location=eq.${toLocation}`,
      },
      async () => {
        const transfers = await getPendingTransfers(toLocation);
        callback(transfers);
      }
    )
    .subscribe();

  return () => {
    supabase.removeChannel(channel);
  };
}

// ============================================================================
// Connection Status
// ============================================================================

export function subscribeToConnectionStatus(
  callback: (connected: boolean) => void
): (() => void) {
  const channel = supabase.channel('connection_status');

  channel
    .subscribe((status) => {
      callback(status === 'SUBSCRIBED');
    });

  return () => {
    supabase.removeChannel(channel);
  };
}

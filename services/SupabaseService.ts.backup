/**
 * Supabase Client Service
 * Primary backend service for Prasadam Distribution
 * Provides fast, reliable data access with real-time subscriptions
 */

import { createClient } from '@supabase/supabase-js';
import type {
  Event,
  EventInsert,
  Meal,
  MealInsert,
  MenuItem,
  MenuItemInsert,
  LocationInventory,
  LocationInventoryInsert,
  LocationInventoryUpdate,
  Transfer,
  TransferInsert,
  RefillRequest,
  RefillRequestInsert,
  DashboardSetting,
  DashboardSettingInsert,
  DashboardSummaryData,
  RealtimePayload,
  RealtimeChannel,
} from '../supabase/types';

// ============================================================================
// Configuration
// ============================================================================

const SUPABASE_URL = process.env.EXPO_PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON_KEY = process.env.EXPO_PUBLIC_SUPABASE_ANON_KEY || '';

if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
  console.warn('[SupabaseService] Missing credentials. Set EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY in .env.local');
}

// Create Supabase client (only if configured, otherwise provide a dummy client)
export const supabase = SUPABASE_URL && SUPABASE_ANON_KEY
  ? createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      auth: {
        persistSession: false, // We manage session separately via AsyncStorage
      },
      db: {
        schema: 'public',
      },
      realtime: {
        params: {
          eventsPerSecond: 10,
        },
      },
    })
  : null;

// ============================================================================
// Generic Query Helpers
// ============================================================================

type QueryResult<T> = {
  data: T | null;
  error: Error | null;
};

function mapQueryResult<T>(result: QueryResult<T>): T | null {
  if (result.error) {
    console.error('[SupabaseService] Query error:', result.error);
    return null;
  }
  return result.data;
}

async function handleQuery<T>(
  query: Promise<QueryResult<T>>
): Promise<T | null> {
  try {
    const result = await query;
    return mapQueryResult(result);
  } catch (error) {
    console.error('[SupabaseService] Query exception:', error);
    return null;
  }
}

// Helper to check if Supabase is available
export function isSupabaseAvailable(): boolean {
  return supabase !== null;
}

// ============================================================================
// Events
// ============================================================================

export async function getEvents(): Promise<Event[]> {
  if (!supabase) {
    console.warn('[SupabaseService] Supabase not configured, returning empty events');
    return [];
  }

  const { data, error } = await supabase
    .from('events')
    .select('*')
    .order('created_at', { ascending: false });

  if (error) {
    console.error('[SupabaseService] getEvents error:', error);
    return [];
  }
  return data || [];
}

export async function getEvent(eventId: string): Promise<Event | null> {
  return handleQuery(
    supabase.from('events').select('*').eq('event_id', eventId).single()
  );
}

export async function createEvent(event: EventInsert): Promise<boolean> {
  const { error } = await supabase.from('events').insert(event);
  return !error;
}

// ============================================================================
// Meals
// ============================================================================

export async function getMeals(eventId: string): Promise<Meal[]> {
  const { data, error } = await supabase
    .from('meals')
    .select('*')
    .eq('event_id', eventId)
    .order('day_number', { ascending: true })
    .order('serving_start_time', { ascending: true });

  if (error) {
    console.error('[SupabaseService] getMeals error:', error);
    return [];
  }
  return data || [];
}

export async function getMeal(mealId: string): Promise<Meal | null> {
  return handleQuery(
    supabase.from('meals').select('*').eq('meal_id', mealId).single()
  );
}

export async function createMeal(meal: MealInsert): Promise<boolean> {
  const { error } = await supabase.from('meals').insert(meal);
  return !error;
}

export async function updateMealDevotees(
  mealId: string,
  expectedDevotees: number
): Promise<boolean> {
  const { error } = await supabase
    .from('meals')
    .update({ expected_devotees: expectedDevotees })
    .eq('meal_id', mealId);
  return !error;
}

// ============================================================================
// Menu Items
// ============================================================================

export async function getMenuItems(mealId: string): Promise<MenuItem[]> {
  const { data, error } = await supabase
    .from('menu_items')
    .select('*')
    .eq('meal_id', mealId)
    .order('category', { ascending: true })
    .order('name', { ascending: true });

  if (error) {
    console.error('[SupabaseService] getMenuItems error:', error);
    return [];
  }
  // Log one item to see the structure
  if (data && data.length > 0) {
    console.log('[SupabaseService] getMenuItems sample item:', {
      item_id: data[0].item_id,
      name: data[0].name,
      ready_trays: data[0].ready_trays,
      planned_trays: data[0].planned_trays,
    });
  }
  return data || [];
}

export async function createMenuItem(item: MenuItemInsert): Promise<boolean> {
  const { error } = await supabase.from('menu_items').insert(item);
  return !error;
}

export async function updateMenuItem(
  itemId: string,
  updates: Partial<MenuItemInsert>
): Promise<boolean> {
  console.log('[SupabaseService] updateMenuItem:', itemId, updates);
  const { error, data } = await supabase
    .from('menu_items')
    .update(updates)
    .eq('item_id', itemId)
    .select();
  if (error) {
    console.error('[SupabaseService] updateMenuItem error:', error);
  } else {
    console.log('[SupabaseService] updateMenuItem success, updated data:', data);
  }
  return !error;
}

export async function updateCookingStatus(
  itemId: string,
  status: string
): Promise<boolean> {
  const { error } = await supabase
    .from('menu_items')
    .update({ cooking_status: status })
    .eq('item_id', itemId);
  return !error;
}

export async function updateTrayCount(
  itemId: string,
  adjustment: number
): Promise<boolean> {
  // First get current value, then update
  const { data } = await supabase
    .from('menu_items')
    .select('ready_trays')
    .eq('item_id', itemId)
    .single();

  if (!data) return false;

  const newCount = Math.max(0, (data.ready_trays || 0) + adjustment);

  const { error } = await supabase
    .from('menu_items')
    .update({ ready_trays: newCount })
    .eq('item_id', itemId);
  return !error;
}

// ============================================================================
// Location Inventory
// ============================================================================

export async function getLocationInventory(
  mealId: string
): Promise<LocationInventory[]> {
  const { data, error } = await supabase
    .from('location_inventory')
    .select('*')
    .eq('meal_id', mealId)
    .order('category', { ascending: true })
    .order('item_name', { ascending: true });

  if (error) {
    console.error('[SupabaseService] getLocationInventory error:', error);
    return [];
  }
  return data || [];
}

export async function getLocationInventoryItem(
  mealId: string,
  itemId: string
): Promise<LocationInventory | null> {
  console.log('[SupabaseService] getLocationInventoryItem:', mealId, itemId);
  const result = await supabase
    .from('location_inventory')
    .select('*')
    .eq('meal_id', mealId)
    .eq('item_id', itemId)
    .maybeSingle();  // Use maybeSingle() instead of single() to avoid error when not found
  console.log('[SupabaseService] getLocationInventoryItem result data:', result.data, 'error:', result.error);
  if (result.error) {
    console.error('[SupabaseService] getLocationInventoryItem error:', result.error);
    return null;
  }
  return result.data;
}

/**
 * Update location inventory with atomic operation
 * Uses PostgreSQL's built-in atomic operations for consistency
 */
export async function updateLocationInventory(
  data: LocationInventoryUpdate
): Promise<boolean> {
  const { meal_id, item_id, location, quantity, action } = data;

  // Build the update expression based on action
  const operator = action === 'add' ? '+' : '-';

  const { error } = await supabase.rpc('update_inventory_location', {
    p_meal_id: meal_id,
    p_item_id: item_id,
    p_location: location,
    p_quantity: quantity,
    p_action: action,
  });

  if (error) {
    console.error('[SupabaseService] updateLocationInventory error:', error);
    // Fallback: try direct query if RPC doesn't exist
    return fallbackUpdateLocationInventory(data);
  }

  return true;
}

// Fallback implementation for when RPC function doesn't exist
async function fallbackUpdateLocationInventory(
  data: LocationInventoryUpdate
): Promise<boolean> {
  const { meal_id, item_id, location, quantity, action } = data;
  console.log('[SupabaseService] fallbackUpdateLocationInventory:', { meal_id, item_id, location, quantity, action });

  // Map UI location names to database column names
  const locationColumnMap: Record<string, string> = {
    'Kitchen': 'kitchen',
    'Staging': 'staging',
    'Refill 1': 'refill_1',
    'Refill 2': 'refill_2',
    'Refill 3': 'refill_3',
    'Served': 'served',
    'Left Over': 'left_over',
  };
  const dbLocation = locationColumnMap[location] || location.toLowerCase();

  // Get current value
  const current = await getLocationInventoryItem(meal_id, item_id);
  console.log('[SupabaseService] fallbackUpdateLocationInventory current:', current);
  if (!current) {
    console.error('[SupabaseService] fallbackUpdateLocationInventory: current is null');
    return false;
  }

  const currentValue = (current as any)[dbLocation] || 0;
  const newValue = action === 'add'
    ? currentValue + quantity
    : Math.max(0, currentValue - quantity);
  console.log('[SupabaseService] fallbackUpdateLocationInventory updating:', dbLocation, currentValue, '->', newValue);

  const { error, data: updatedData } = await supabase
    .from('location_inventory')
    .update({ [dbLocation]: newValue })
    .eq('meal_id', meal_id)
    .eq('item_id', item_id);

  console.log('[SupabaseService] fallbackUpdateLocationInventory update result:', { error, updatedData });
  return !error;
}

export async function upsertLocationInventory(
  item: LocationInventoryInsert
): Promise<boolean> {
  const { error } = await supabase
    .from('location_inventory')
    .upsert(item, { onConflict: 'meal_id,item_id' });
  return !error;
}

// ============================================================================
// Transfers
// ============================================================================

export async function getTransfers(mealId: string): Promise<Transfer[]> {
  const { data, error } = await supabase
    .from('transfers')
    .select('*')
    .eq('meal_id', mealId)
    .order('timestamp_sent', { ascending: false });

  if (error) {
    console.error('[SupabaseService] getTransfers error:', error);
    return [];
  }
  return data || [];
}

export async function getRecentTransfers(
  mealId: string,
  itemId: string,
  limit: number = 3
): Promise<Transfer[]> {
  const { data, error } = await supabase
    .from('transfers')
    .select('*')
    .eq('meal_id', mealId)
    .eq('item_id', itemId)
    .order('timestamp_sent', { ascending: false })
    .limit(limit);

  if (error) {
    console.error('[SupabaseService] getRecentTransfers error:', error);
    return [];
  }
  return data || [];
}

export async function getPendingTransfers(
  toLocation: string
): Promise<Transfer[]> {
  const { data, error } = await supabase
    .from('transfers')
    .select('*')
    .eq('to_location', toLocation)
    .eq('status', 'sent')
    .order('timestamp_sent', { ascending: true });

  if (error) {
    console.error('[SupabaseService] getPendingTransfers error:', error);
    return [];
  }
  return data || [];
}

export async function createTransfer(transfer: TransferInsert): Promise<string | null> {
  const transfer_id = transfer.transfer_id || `tr_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`;

  const { error } = await supabase.from('transfers').insert({
    ...transfer,
    transfer_id,
  });

  if (error) {
    console.error('[SupabaseService] createTransfer error:', error);
    return null;
  }

  return transfer_id;
}

export async function recordTransfer(transfer: TransferInsert): Promise<string | null> {
  // Alias for createTransfer - same operation
  return createTransfer(transfer);
}

export async function receiveTransfer(
  transferId: string
): Promise<boolean> {
  const { error } = await supabase
    .from('transfers')
    .update({
      status: 'received',
      timestamp_received: new Date().toISOString(),
    })
    .eq('transfer_id', transferId);

  return !error;
}

